//3.ÜYELER tablosunda kayıtların var olduğu varsayıldığında, kayıtları “UyeNo” sütununa göre 
artan sırada listelemek için gerekli SQL ifadesini yazınız.

SELECT * 
FROM Uyeler
ORDER BY uyeNo ASC;

//4.Ocak 2023 ‘ten sonra emanet alınan kitapları listelemek için gerekli SQL ifadeleri yazınız.

SELECT * 
FROM Emanet
WHERE emanetTarihi > '2023-01-01';

//5.Kayseri’de ikamet eden ve telefonu içerisinde 6 içeren üyeleri listelemek için gerekli SQL ifadesini yazınız.

SELECT * 
FROM Uyeler U
JOIN Adresler A ON U.adresNo = A.adresNo
WHERE A.sehir = 'Kayseri'
AND U.telefon LIKE '%6%';

//6.Teslim tarihi 1 ay dan az kalan kitapları listelemek için gerekli SQL ifadesini yazınız.

SELECT * 
FROM Emanet
WHERE DATEDIFF(DAY, GETDATE(), teslimTarihi) < 30;

//7.Soyadı beş karakterden fazla olan müşterilerin ad ve soyad bilgisini adının ilk harfini ve soyadının ilk beş karakterini 
birleştirerek tek bir sütunda adına göre alfabetik sırada listelemek için gerekli SQL ifadesini yazınız.

SELECT 
LEFT(uyeAdi,1) + LEFT(uyeSoyadi,5) AS AdSoyad
FROM Uyeler
WHERE LEN(uyeSoyadi) > 5
ORDER BY uyeAdi ASC;

//8.Üyelerin sadece “Sehir” bilgisini alfabetik olarak listelemek için gerekli SQL ifadesini yazınız.

SELECT sehir 
FROM Adresler
ORDER BY sehir ASC;

//9.2020 yılında yapılan emanet sayısını bulmak için gerekli SQL ifadesini yazınız.

SELECT COUNT(*) 
FROM Emanet
WHERE YEAR(emanetTarihi) = 2020;

//10.Emanet alınan kütüphanenin ismi “Kayseri Belediyesi Merkez Kütüphanesi” olan kitapların 
emanet süresi 6 aydan fazla olan alımları listelemek için gerekli SQL ifadesini yazınız.

SELECT E.*
FROM Emanet E
JOIN Kitap_Kutuphane KK ON E.ISBN = KK.ISBN
JOIN Kutuphane K ON KK.kutuphaneNo = K.kutuphaneNo
WHERE K.kutuphaneIsmi = 'Kayseri Belediyesi Merkez Kütüphanesi'
AND DATEDIFF(MONTH, E.emanetTarihi, E.teslimTarihi) > 6;

//11.Eskişehir’de yaşayan üyelerin sayısını bulmak için gerekli SQL ifadesini yazınız.

SELECT COUNT(*)
FROM Uyeler U
JOIN Adresler A ON U.adresNo = A.adresNo
WHERE A.sehir = 'Eskişehir';

//12.“YayınTarihi” 3 yaşından büyük olan kitapların yazar bilgisini listelemek için gerekli SQL ifadesini yazınız.

SELECT Y.*
FROM Kitaplar K
JOIN Kitap_Yazar KY ON K.ISBN = KY.ISBN
JOIN Yazarlar Y ON KY.yazarNo = Y.yazarNo
WHERE DATEDIFF(YEAR, K.yayinTarihi, GETDATE()) > 3;

//13.Her bir kitabın emanet edildiği sürelerin en uzun ve en kısa olanları bulunuz.

SELECT 
MAX(DATEDIFF(DAY, emanetTarihi, teslimTarihi)) AS EnUzun,
MIN(DATEDIFF(DAY, emanetTarihi, teslimTarihi)) AS EnKisa
FROM Emanet;

//14.Emanet verilen kitapları, emanet alan üyelerin ad ve soyad bilgisini listelemek için gerekli SQL ifadesini yazınız.

SELECT U.uyeAdi, U.uyeSoyadi, K.kitapAdi
FROM Emanet E
JOIN Uyeler U ON E.uyeNo = U.uyeNo
JOIN Kitaplar K ON E.ISBN = K.ISBN;



















