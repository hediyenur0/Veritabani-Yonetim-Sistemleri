//1.(UYELER, ADRESLER, KUTUPHANE, Emanet, KİTAPLAR, YAZARLAR, KATEGORİLER, KITAP_KUTUPHANE, KITAP_KATEGORI, KITAP_YAZAR) gösterimini yapınız. 
//(Tablo isimleri verilmiştir, her tablodaki primary_key(PK) ve foreign_key(FK)’ları gösteriniz.)

CREATE TABLE Adresler(
    adresNo INT PRIMARY KEY IDENTITY(1,1),
    sehir NVARCHAR(50),
    mahalle NVARCHAR(50)
);

CREATE TABLE Uyeler(
    uyeNo INT PRIMARY KEY IDENTITY(1,1),
    uyeAdi NVARCHAR(50),
    uyeSoyadi NVARCHAR(50),
    telefon NVARCHAR(50),
    adresNo INT,
    FOREIGN KEY (adresNo) REFERENCES Adresler(adresNo)
);

CREATE TABLE Kutuphane(
    kutuphaneNo INT PRIMARY KEY,
    kutuphaneIsmi NVARCHAR(100),
    adresNo INT,
    FOREIGN KEY (adresNo) REFERENCES Adresler(adresNo)
);

CREATE TABLE Kitaplar(
    ISBN NVARCHAR(50) PRIMARY KEY,
    kitapAdi NVARCHAR(100),
    yayinTarihi DATETIME
);

CREATE TABLE Yazarlar(
    yazarNo INT PRIMARY KEY IDENTITY(1,1),
    yazarAdi NVARCHAR(50),
    yazarSoyadi NVARCHAR(50)
);

CREATE TABLE Kategori(
    kategoriNo INT PRIMARY KEY IDENTITY(1,1),
    kategoriAdi NVARCHAR(50)
);

CREATE TABLE Emanet(
    emanetNo INT PRIMARY KEY IDENTITY(1,1),
    emanetTarihi DATETIME,
    teslimTarihi DATETIME,
    uyeNo INT,
    ISBN NVARCHAR(50),
    FOREIGN KEY (uyeNo) REFERENCES Uyeler(uyeNo),
    FOREIGN KEY (ISBN) REFERENCES Kitaplar(ISBN)
);

CREATE TABLE Kitap_Yazar(
    id INT PRIMARY KEY IDENTITY(1,1),
    ISBN NVARCHAR(50),
    yazarNo INT,
    FOREIGN KEY (ISBN) REFERENCES Kitaplar(ISBN),
    FOREIGN KEY (yazarNo) REFERENCES Yazarlar(yazarNo)
);

CREATE TABLE Kitap_Kategori(
    id INT PRIMARY KEY IDENTITY(1,1),
    ISBN NVARCHAR(50),
    kategoriNo INT,
    FOREIGN KEY (ISBN) REFERENCES Kitaplar(ISBN),
    FOREIGN KEY (kategoriNo) REFERENCES Kategori(kategoriNo)
);

CREATE TABLE Kitap_Kutuphane(
    id INT PRIMARY KEY IDENTITY(1,1),
    ISBN NVARCHAR(50),
    kutuphaneNo INT,
    FOREIGN KEY (ISBN) REFERENCES Kitaplar(ISBN),
    FOREIGN KEY (kutuphaneNo) REFERENCES Kutuphane(kutuphaneNo)
);

